<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat is required by local_auth's fingerprint/PIN prompt. Keep the
         launch light even in system dark mode: Docify currently has one theme. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/splash_background</item>
    </style>
    <!-- Match the first Flutter frame while its surface attaches, rather than
         briefly showing AppCompat's default white/dark window background. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
