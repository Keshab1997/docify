<?xml version="1.0" encoding="utf-8"?>
<!-- The clay artwork is drawn edge-to-edge in the background layer, with the
     hero already inside the 66dp safe zone, so every launcher mask (circle,
     squircle, teardrop) crops it cleanly. The foreground is intentionally
     empty. The monochrome layer is what Android 13+ tints for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
